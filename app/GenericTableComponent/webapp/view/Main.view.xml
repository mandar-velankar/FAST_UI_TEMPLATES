<mvc:View controllerName="com.bayer.SXTENDER.templates.GenericTableComponent.controller.Main" displayBlock="true" xmlns="sap.m" xmlns:f="sap.f" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table">
    <f:DynamicPage id="masterPage" stickySubheaderProvider="iconTabBar" class="sapUiNoContentPadding">
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>appTitle}" level="H2" />
                </f:heading>
                <f:actions />
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <t:Table id="genericTable" 
                visibleRowCountMode="Auto" 
                columns="{path:'tempModel>/countryTemplate/template/table/columns', factory: '.createColumns'}" />
        </f:content>
    </f:DynamicPage>
</mvc:View>

{
  "name": "F_TNDR_CAG_FAST_UI_TEMPLATES",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^2.14.0",
    "@sap/cds": "^6",
    "@sap/cds-dk": "^6.4.0",
    "@sap/xsenv": "^3.4.0",
    "@sap/xssec": "^3.2.17",
    "@types/node": "^18.11.18",
    "express": "^4",
    "hdb": "^0.19.0",
    "passport": "^0.6.0",
    "rimraf": "^3.0.2"
  },
  "devDependencies": {
    "@sap/ux-specification": "^1.102.17",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^7.32.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "sqlite3": "^5.0.4",
    "ts-node": "^10.4.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "cds run",
    "start-service:ts": "cds-ts run --with-mocks --in-memory",
    "watch:ts": "cds-ts watch --port 4005",
    "watch:ts:hybrid": "cds bind --exec npm run watch:ts --profile hybrid",
    "watch:ts:as": "cds bind --exec npm run watch:ts --profile artiom",
    "watch:ts:mv": "cds bind --exec npm run watch:ts --profile mandar",
    "watch:ts:jp": "cds bind --exec npm run watch:ts --profile jorj",
    "build:cf": "npm run build:cds && npm run build:ts && npm run cleanup:ts && npm run cleanup:ts",
    "build:ts": "tsc",
    "build:cds": "cds-ts build --production",
    "cleanup:ts": "npx rimraf gen/srv/srv/**/*.ts",
    "ts-typecheck": "tsc --noEmit",
    "undeploy": "cf undeploy F_TNDR_CAG_FAST_UI_TEMPLATES --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy:sql": "cds deploy --to sqlite",
    "deploy:hana": "cds deploy --to hana --profile hybrid",
    "deploy:hana:as": "cds bind --exec cds deploy --to hana --profile artiom",
    "deploy:hana:mv": "cds bind --exec cds deploy --to hana --profile mandar",
    "deploy:hana:jp": "cds bind --exec cds deploy --to hana --profile jorj",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "hana": {
      "deploy-format": "hdbtable"
    },
    "requires": {
      "db": {
        "kind": "hana-cloud"
      },
      "uaa": {
        "kind": "xsuaa"
      },
      "auth": {
        "kind": "jwt-auth"
      }
    }
  }
}
